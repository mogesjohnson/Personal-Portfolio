{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion-system.schema.json",
  "title": "Motion system spec",
  "description": "Schema for website-template/motion-system.json. Validates the parts code reads (tokens, patterns, connectors); the documentation sections are left open.",
  "type": "object",
  "required": ["meta", "tokens", "patterns"],
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "tokens": {
      "type": "object",
      "required": ["color", "layout", "easing", "duration"],
      "properties": {
        "color": {
          "type": "object",
          "required": ["dark", "light"],
          "properties": {
            "dark": { "$ref": "#/$defs/stringMap" },
            "light": { "$ref": "#/$defs/stringMap" }
          }
        },
        "layout": { "$ref": "#/$defs/stringMap" },
        "easing": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["css", "gsap", "use"],
            "properties": { "css": { "type": "string" }, "gsap": { "type": "string" }, "use": { "type": "string" } }
          }
        },
        "duration": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["css", "seconds", "use"],
            "properties": { "css": { "type": "string" }, "seconds": { "type": "number", "minimum": 0 }, "use": { "type": "string" } }
          }
        }
      }
    },
    "patterns": {
      "type": "array",
      "items": { "$ref": "#/$defs/pattern" }
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "source": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string" },
        "lines": { "type": "string" },
        "symbol": { "type": "string" }
      }
    },
    "connector": {
      "type": "object",
      "required": ["kind", "module"],
      "properties": {
        "kind": { "enum": ["scene", "css", "component", "hook", "lib", "engine", "script"] },
        "module": { "type": "string" },
        "export": { "type": "string" },
        "registryKey": { "type": "string" },
        "className": { "type": "string" }
      },
      "if": { "properties": { "kind": { "const": "scene" } } },
      "then": { "required": ["registryKey"] }
    },
    "pattern": {
      "type": "object",
      "required": ["id", "name", "category", "summary", "connector"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string" },
        "category": {
          "enum": [
            "boot",
            "runtime",
            "intro",
            "entrance",
            "scroll-reveal",
            "scroll-scrub",
            "scroll-pin",
            "marquee",
            "pointer",
            "transition",
            "navigation",
            "state-change",
            "ambient",
            "particles",
            "fallback"
          ]
        },
        "summary": { "type": "string" },
        "technique": { "type": "string" },
        "enabled": { "type": "boolean" },
        "source": { "$ref": "#/$defs/source" },
        "cssSource": { "$ref": "#/$defs/source" },
        "params": { "type": "object" },
        "reducedMotion": { "type": "string" },
        "gotchas": { "type": "array", "items": { "type": "string" } },
        "remix": { "type": "array", "items": { "type": "string" } },
        "connector": { "$ref": "#/$defs/connector" }
      }
    }
  }
}
